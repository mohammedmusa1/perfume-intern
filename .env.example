# =============================================================================
# AuraPerfume — Environment Variables
# =============================================================================

# General
NODE_ENV=development
APP_NAME=AuraPerfume

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=auraperfume
DATABASE_USER=auraperfume_user
DATABASE_PASSWORD=auraperfume_secret_2024
DATABASE_URL=postgresql://auraperfume_user:auraperfume_secret_2024@localhost:5432/auraperfume

# JWT
JWT_SECRET=aura-perfume-jwt-secret-change-in-production-2024
JWT_REFRESH_SECRET=aura-perfume-refresh-secret-change-in-production-2024
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Service Ports
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
PRODUCT_SERVICE_PORT=3002
CART_SERVICE_PORT=3003
ORDER_SERVICE_PORT=3004
PAYMENT_SERVICE_PORT=3005
COUPON_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3007
ADMIN_SERVICE_PORT=3008
FRONTEND_PORT=4000

# Service URLs (internal)
AUTH_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002
CART_SERVICE_URL=http://localhost:3003
ORDER_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3005
COUPON_SERVICE_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3007
ADMIN_SERVICE_URL=http://localhost:3008

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Resend (Email)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@auraperfume.com
ADMIN_EMAIL=admin@auraperfume.com

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
NEXT_PUBLIC_APP_URL=http://localhost:4000

# Redis (for sessions/caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=http://localhost:4000

# Logging
LOG_LEVEL=debug

# Prometheus
METRICS_ENABLED=true
METRICS_PORT=9090
